# Copy to .env and fill in before `docker compose up -d`

# Public host/domain n8n is reached at. If you're behind a reverse proxy
# with a real domain (recommended for production), set this to that domain
# and N8N_PROTOCOL=https.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

GENERIC_TIMEZONE=UTC

# Locks down the n8n editor UI (not the webhook itself — webhooks stay
# public by design so the CLI can reach them without auth).
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-something-strong
